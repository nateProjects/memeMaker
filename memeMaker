#!/bin/bash

set -e

if [ $# -lt 3 ]; then
    echo "Usage: $0 <input_image> <output_image> <text> [side] [border_percentage] [font]"
    echo "Side options: top, bottom, left, right (default: bottom)"
    echo "Text should be enclosed in quotes if it contains spaces"
    echo "Border percentage: 25-50 adds a solid border (default: 25 top/bottom, 50 left/right)"
    echo "                   0 overlays text directly onto the image"
    echo "Font is optional. If not provided, the system default will be used"
    exit 1
fi

input_image="$1"
output_image="$2"
text="$3"
side="${4:-bottom}"
border_percentage="${5:-}"
font="${6:-}"

if [ ! -f "$input_image" ]; then
    echo "Error: Input file '$input_image' not found."
    exit 1
fi

overlay_mode=false

if [ -z "$border_percentage" ]; then
    case $side in
        top|bottom)
            border_percentage=25
            ;;
        left|right)
            border_percentage=50
            ;;
        *)
            echo "Invalid side option '$side'. Defaulting to bottom."
            side="bottom"
            border_percentage=25
            ;;
    esac
elif [ "$border_percentage" = "0" ]; then
    overlay_mode=true
    case $side in
        top|bottom) border_percentage=25 ;;
        left|right) border_percentage=50 ;;
    esac
else
    if ! [[ "$border_percentage" =~ ^[0-9]+$ ]] || [ "$border_percentage" -lt 25 ] || [ "$border_percentage" -gt 50 ]; then
        echo "Border percentage must be an integer between 25 and 50, or 0 for overlay. Defaulting to 25%."
        border_percentage=25
    fi
fi

echo "Using side: $side"
if [ "$overlay_mode" = "true" ]; then
    echo "Mode: overlay"
else
    echo "Using border percentage: $border_percentage%"
fi

find_system_font() {
    local candidates=(
        "/System/Library/Fonts/Supplemental/Arial.ttf"
        "/System/Library/Fonts/Helvetica.ttc"
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
        "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf"
        "/usr/share/fonts/opentype/urw-base35/NimbusSans-Regular.otf"
    )
    for f in "${candidates[@]}"; do
        [ -f "$f" ] && echo "$f" && return
    done
}

font_args=()
if [ -n "$font" ]; then
    if [ -f "$font" ]; then
        font_args=(-font "$font")
    elif magick -list font | grep -qi "$font"; then
        font_args=(-font "$font")
    else
        echo "Warning: Font '$font' not found. Using system default."
    fi
fi

# ImageMagick often has no registered fonts on macOS — fall back to a known font file
if [ ${#font_args[@]} -eq 0 ]; then
    fallback=$(find_system_font)
    if [ -n "$fallback" ]; then
        font_args=(-font "$fallback")
    fi
fi

dimensions=$(magick identify -format "%w %h" "$input_image")
width=$(echo "$dimensions" | cut -d' ' -f1)
height=$(echo "$dimensions" | cut -d' ' -f2)

echo "Original image dimensions: ${width}x${height}"

# Scale buffer to 2% of the shorter dimension so it looks consistent across image sizes
text_buffer=$(( (width < height ? width : height) * 2 / 100 ))
[ "$text_buffer" -lt 4 ] && text_buffer=4

case $side in
    top|bottom)
        border_size=$(( height * border_percentage / 100 ))
        if [ "$overlay_mode" = "true" ]; then
            new_width=$width
            new_height=$height
        else
            new_width=$width
            new_height=$(( height + border_size ))
        fi
        if [ "$side" = "top" ]; then
            offset="+0+${border_size}"
            text_position="+${text_buffer}+${text_buffer}"
        else
            offset="+0+0"
            if [ "$overlay_mode" = "true" ]; then
                text_position="+${text_buffer}+$((height - border_size + text_buffer))"
            else
                text_position="+${text_buffer}+$((height + text_buffer))"
            fi
        fi
        text_size="$((width - 2*text_buffer))x$((border_size - 2*text_buffer))"
        ;;
    left|right)
        border_size=$(( width * border_percentage / 100 ))
        if [ "$overlay_mode" = "true" ]; then
            new_width=$width
            new_height=$height
        else
            new_width=$(( width + border_size ))
            new_height=$height
        fi
        if [ "$side" = "left" ]; then
            offset="+${border_size}+0"
            text_position="+${text_buffer}+${text_buffer}"
        else
            offset="+0+0"
            if [ "$overlay_mode" = "true" ]; then
                text_position="+$((width - border_size + text_buffer))+${text_buffer}"
            else
                text_position="+$((width + text_buffer))+${text_buffer}"
            fi
        fi
        text_size="$((border_size - 2*text_buffer))x$((height - 2*text_buffer))"
        ;;
esac

echo "Text area: $text_size"
echo "Output dimensions: ${new_width}x${new_height}"

temp_file=$(mktemp /tmp/memeMaker_XXXXXX.png)
trap 'rm -f "$temp_file"' EXIT

if [ "$overlay_mode" = "true" ]; then
    magick -background 'rgba(0,0,0,0.6)' -fill white "${font_args[@]}" -size "$text_size" \
        caption:"$text" \
        "$temp_file"

    magick "$input_image" \
        "$temp_file" -geometry "$text_position" -composite \
        "$output_image"
else
    magick -background black -fill white "${font_args[@]}" -size "$text_size" \
        caption:"$text" \
        "$temp_file"

    magick -size "${new_width}x${new_height}" xc:black \
        "$input_image" -geometry "$offset" -composite \
        "$temp_file" -geometry "$text_position" -composite \
        "$output_image"
fi

if [ -f "$output_image" ]; then
    output_dimensions=$(magick identify -format "%w %h" "$output_image")
    echo "Done. Output: $output_image (${output_dimensions})"
else
    echo "Error: Output file was not created."
    exit 1
fi
